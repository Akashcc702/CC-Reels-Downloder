# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here

# Instagram cookies in base64 format (for Instagram/Facebook downloads)
# Run: base64 -w 0 cookies.txt   to generate this value
# Then set it in Render → Environment Variables
INSTAGRAM_COOKIES=

# Optional web server port (default: 8080)
# PORT=8080
